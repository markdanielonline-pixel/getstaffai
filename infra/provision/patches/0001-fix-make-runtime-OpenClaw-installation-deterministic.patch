+test('openclaw version guard matches a suffixed pinned build and verifies dist integrity', function () {
+    // Regression: the version regex could not capture a build suffix, so a pin
+    // of "2026.7.1-2" was compared against a truncated "2026.7.1", never
+    // matched, and reinstalled globally on every run. Concurrent/interrupted
+    // installs then left dist/ holding chunks from two builds, which surfaced
+    // as ERR_MODULE_NOT_FOUND and a workforce that passed readiness but could
+    // not execute any task.
+    config(['provision.openclaw_version' => '2026.7.1-2']);
+
+    $team = Team::factory()->create();
+    $server = Server::factory()->running()->create(['team_id' => $team->id]);
+    $agent = Agent::factory()->create([
+        'team_id' => $team->id,
+        'server_id' => $server->id,
+        'harness_agent_id' => 'agent-suffix',
+        'harness_type' => HarnessType::OpenClaw,
+        'name' => 'Suffixed',
+        'status' => AgentStatus::Active,
+    ]);
+
+    $script = app(AgentUpdateScriptService::class)->generateOpenClawScript($agent);
+
+    expect($script)->toContain("PINNED_OPENCLAW_VERSION='2026.7.1-2'")
+        // The extraction regex must admit the suffix, or the guard can never
+        // be satisfied by a pinned build.
+        ->toContain('(-[0-9A-Za-z.]+)?')
+        // Installs must be serialised and a corrupt tree cleared, not layered.
+        ->toContain('flock /var/lock/openclaw-install.lock')
+        ->toContain('rm -rf /usr/lib/node_modules/openclaw')
+        // And the result must be verified, not assumed.
+        ->toContain('FATAL: openclaw did not converge');
+
+    // Integrity verification must run before the gateway is restarted and
+    // trusted, otherwise a broken runtime is marked healthy.
+    $checkPos = strpos($script, 'OPENCLAW_DIST_CHECK=');
+    $restartPos = strpos($script, 'systemctl --user restart openclaw-gateway');
+    expect($checkPos)->toBeLessThan($restartPos);
+});
+
